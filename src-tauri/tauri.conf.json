{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QPack",
  "version": "0.1.8",
  "identifier": "com.qpack.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QPack",
        "width": 980,
        "height": 660,
        "minWidth": 720,
        "minHeight": 500,
        "center": true,
        "visible": false,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "infoPlist": "./Info.plist",
      "dmg": {
        "background": "./icons/dmg-background.tiff",
        "windowSize": {
          "width": 660,
          "height": 420
        },
        "appPosition": {
          "x": 180,
          "y": 215
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 215
        }
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "./icons/icon.ico",
        "sidebarImage": "./icons/win-nsis-sidebar.bmp",
        "headerImage": "./icons/win-nsis-header.bmp",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "zh-CN",
        "dialogImagePath": "./icons/win-wix-dialog.bmp",
        "bannerPath": "./icons/win-wix-banner.bmp"
      }
    },
    "fileAssociations": [
      {
        "ext": ["zip", "jar", "apk", "ipa", "epub", "cbz"],
        "name": "QPack.zip",
        "description": "QPack ZIP 压缩包",
        "mimeType": "application/zip",
        "role": "Editor"
      },
      {
        "ext": ["7z"],
        "name": "QPack.7z",
        "description": "QPack 7Z 压缩包",
        "mimeType": "application/x-7z-compressed",
        "role": "Editor"
      },
      {
        "ext": ["rar"],
        "name": "QPack.rar",
        "description": "QPack RAR 压缩包",
        "mimeType": "application/vnd.rar",
        "role": "Viewer"
      },
      {
        "ext": ["tar"],
        "name": "QPack.tar",
        "description": "QPack TAR 归档文件",
        "mimeType": "application/x-tar",
        "role": "Editor"
      },
      {
        "ext": ["gz", "tgz"],
        "name": "QPack.gz",
        "description": "QPack GZIP 压缩包",
        "mimeType": "application/gzip",
        "role": "Editor"
      },
      {
        "ext": ["zst", "tzst"],
        "name": "QPack.zst",
        "description": "QPack Zstandard 压缩包",
        "mimeType": "application/zstd",
        "role": "Editor"
      },
      {
        "ext": ["bz2", "tbz2", "xz", "txz", "iso", "cab", "dmg", "wim", "rpm", "deb", "lzh", "arj", "cpio"],
        "name": "QPack.archive",
        "description": "QPack 压缩包",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5OTMzMkMwMkRBMjA0QzgKUldUSUJLSXR3REtUYVl6N281VkZCU1dNWjJGdDk3dnl5OVJBL1pMRG9MRktjeUhleitJaWFJZUQK",
      "endpoints": [
        "https://github.com/qsw745/qpack/releases/latest/download/latest.json",
        "http://192.168.31.147:8080/releases/latest.json"
      ],
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
